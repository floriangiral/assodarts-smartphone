rules_version = '2';

// Mirrors the tenant isolation and role checks that Postgres RLS used to
// enforce: a member only ever sees data of clubs they belong to, and only an
// active admin/board membership can write club-wide or money-moving data.
// Payment-state transitions (declare/validate/cancel) and anything Stripe or
// notification related are intentionally NOT writable by clients — they go
// through the Cloud Functions in `functions/src`, which use the Admin SDK and
// bypass these rules the same way the old Postgres RPCs did.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function membership(clubId) {
      return get(/databases/$(database)/documents/memberships/$(clubId + '_' + request.auth.uid)).data;
    }

    function isActiveMember(clubId) {
      return isSignedIn() && membership(clubId).status == 'active';
    }

    function isBoard(clubId) {
      return isActiveMember(clubId) && membership(clubId).role in ['admin', 'board'];
    }

    // An unpaid club keeps full read access — its data stays intact and
    // visible — but stops being able to create or change club content until
    // the subscription is settled. `trial` and `grace` still write: a trial has
    // not been asked to pay yet, and a club in grace is one Stripe is still
    // retrying. Only `expired` is read-only.
    function isSubscriptionActive(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data.subscriptionStatus != 'expired';
    }

    function canWriteClubContent(clubId) {
      return isBoard(clubId) && isSubscriptionActive(clubId);
    }

    function currentMemberId(clubId) {
      return membership(clubId).memberId;
    }

    function isOwnMember(clubId, memberId) {
      return isActiveMember(clubId) && membership(clubId).memberId == memberId;
    }

    function isOwnProfile(memberId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/members/$(memberId)).data.authUid == request.auth.uid;
    }

    // `clubId` is a historical marker frozen at the member's very first club:
    // once non-null it must stay exactly the same forever, it is never a
    // switchable "current club". `defaultClubId` is the only field a member
    // may freely switch, to any club they hold an active membership for.
    function ownClubIdChangeIsValid() {
      return (resource.data.clubId == null || request.resource.data.clubId == resource.data.clubId)
        && (request.resource.data.defaultClubId == resource.data.get('defaultClubId', null)
            || request.resource.data.defaultClubId == null
            || isActiveMember(request.resource.data.defaultClubId));
    }

    // A member's `clubId` only ever names their first club, and `defaultClubId`
    // only their currently active one — both are candidate clubs for shared
    // visibility, neither alone tells the full multi-club story.
    function canViewMemberProfile(member) {
      return (member.clubId != null && isActiveMember(member.clubId))
        || (member.defaultClubId != null && isActiveMember(member.defaultClubId));
    }

    function canAccessConversation(conversation) {
      return isActiveMember(conversation.clubId)
        && (conversation.participantIds.hasAny([membership(conversation.clubId).memberId])
            || (conversation.kind == 'bureau' && isBoard(conversation.clubId)));
    }

    function conversationCreateIsValid(conversation) {
      return conversation.keys().hasOnly(['clubId', 'kind', 'participantIds'])
        && conversation.clubId is string
        && conversation.kind in ['bureau', 'direct']
        && conversation.participantIds is list
        && (
          (conversation.kind == 'bureau'
            && conversation.participantIds.size() == 1
            && conversation.participantIds[0] == currentMemberId(conversation.clubId))
          || (conversation.kind == 'direct'
            && conversation.participantIds.size() == 2
            && conversation.participantIds.hasAny([currentMemberId(conversation.clubId)]))
        );
    }

    function messageCreateIsValid(conversation, message) {
      return message.keys().hasOnly(['senderId', 'text', 'sentAt', 'readBy'])
        && message.senderId == currentMemberId(conversation.clubId)
        && message.text is string
        && message.readBy is list
        && message.readBy.size() == 1
        && message.readBy[0] == currentMemberId(conversation.clubId);
    }

    function isTournamentMarker(clubId, tournamentId) {
      return isActiveMember(clubId)
        && get(/databases/$(database)/documents/tournaments/$(tournamentId))
          .data.markerIds.hasAny([currentMemberId(clubId)]);
    }

    function canCreateTournamentEntry(entry) {
      return isSubscriptionActive(entry.clubId)
        && (isBoard(entry.clubId)
          || (isTournamentMarker(entry.clubId, entry.tournamentId)
            && entry.recordedByMemberId == currentMemberId(entry.clubId)));
    }

    function canDeleteTournamentEntry(entry) {
      return isSubscriptionActive(entry.clubId)
        && (isBoard(entry.clubId) || isTournamentMarker(entry.clubId, entry.tournamentId));
    }

    function pushTokenFieldsAreValid() {
      return request.resource.data.keys().hasOnly(['memberId', 'platform', 'environment', 'locale', 'updatedAt'])
        && request.resource.data.platform in ['ios', 'android']
        && request.resource.data.environment is string
        && request.resource.data.locale is string;
    }

    function paymentItemClientUpdateIsValid() {
      return request.resource.data.clubId == resource.data.clubId
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.paymentCallId == resource.data.paymentCallId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isPaid',
          'paidAt',
          'method',
          'declaredAt',
          'remindedAt',
          'updatedAt'
        ]);
    }

    function bankAccountClientFields() {
      return [
        'clubId',
        'holder',
        'iban',
        'bic',
        'bankName',
        'acceptsTransfer',
        'acceptsCash',
        'transferNote',
        'cashNote',
        'updatedByMemberId',
        'updatedAt'
      ];
    }

    function bankAccountClientCreateIsValid(clubId) {
      return request.resource.data.clubId == clubId
        && request.resource.data.keys().hasOnly(bankAccountClientFields());
    }

    function bankAccountClientUpdateIsValid(clubId) {
      return resource.data.clubId == clubId
        && request.resource.data.clubId == clubId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(bankAccountClientFields());
    }

    match /clubs/{clubId} {
      allow read: if isActiveMember(clubId) || isPlatformAdmin();
      // Subscription fields are written by the Stripe Cloud Functions with the
      // Admin SDK, which bypasses these rules; an expired club can no longer
      // edit its own settings from the app.
      allow write: if canWriteClubContent(clubId);
    }

    match /platform_admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /memberships/{membershipId} {
      allow read: if isSignedIn()
        && (resource.data.authUid == request.auth.uid
            || isActiveMember(resource.data.clubId)
            || isBoard(resource.data.clubId)
            || isPlatformAdmin());
      allow write: if false;
    }

    match /members/{memberId} {
      // `clubId` is null until the member accepts a club invitation, so only
      // the member themselves can read/write their own doc until then.
      allow read: if isSignedIn()
        && (resource.data.authUid == request.auth.uid || canViewMemberProfile(resource.data));
      allow create: if isSignedIn()
        && request.resource.data.authUid == request.auth.uid;
      // Profile, role, licence and status updates go through `updateMemberProfile`
      // so the server can update both `members` and `memberships` atomically.
      // The only direct member write left in the app is switching default club.
      allow update: if isSignedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defaultClubId'])
        && ownClubIdChangeIsValid();
    }

    match /club_bank_accounts/{clubId} {
      allow read: if isActiveMember(clubId);
      allow create: if isBoard(clubId) && bankAccountClientCreateIsValid(clubId);
      allow update: if isBoard(clubId) && bankAccountClientUpdateIsValid(clubId);
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if isActiveMember(resource.data.clubId);
      allow create: if canWriteClubContent(request.resource.data.clubId);
      allow update, delete: if canWriteClubContent(resource.data.clubId);
    }

    match /platform_announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if isActiveMember(resource.data.clubId);
      allow create: if canWriteClubContent(request.resource.data.clubId);
      allow update, delete: if canWriteClubContent(resource.data.clubId);
    }

    match /event_registrations/{registrationId} {
      allow read: if isActiveMember(resource.data.clubId);
      allow create: if isOwnMember(request.resource.data.clubId, request.resource.data.memberId)
        || isBoard(request.resource.data.clubId);
      allow update, delete: if isOwnMember(resource.data.clubId, resource.data.memberId)
        || isBoard(resource.data.clubId);
    }

    match /tournaments/{tournamentId} {
      allow read: if isActiveMember(resource.data.clubId);
      allow create: if canWriteClubContent(request.resource.data.clubId);
      allow update, delete: if canWriteClubContent(resource.data.clubId);
    }

    match /tournament_entries/{entryId} {
      allow read: if isActiveMember(resource.data.clubId);
      allow create: if canCreateTournamentEntry(request.resource.data);
      allow delete: if canDeleteTournamentEntry(resource.data);
      allow update: if false;
    }

    match /conversations/{conversationId} {
      allow read: if canAccessConversation(resource.data);
      allow create: if isActiveMember(request.resource.data.clubId)
        && conversationCreateIsValid(request.resource.data);
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if canAccessConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if canAccessConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && messageCreateIsValid(get(/databases/$(database)/documents/conversations/$(conversationId)).data, request.resource.data);
        allow update: if canAccessConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasAll([membership(get(/databases/$(database)/documents/conversations/$(conversationId)).data.clubId).memberId])
          && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1;
        allow delete: if false;
      }
    }

    match /payment_calls/{callId} {
      allow read: if isActiveMember(resource.data.clubId);
      allow write: if canWriteClubContent(request.resource.data.clubId);
    }

    match /payment_call_items/{itemId} {
      allow read: if isSignedIn()
        && (isOwnMember(resource.data.clubId, resource.data.memberId) || isBoard(resource.data.clubId));
      // `markPaid` (cash/transfer) and `remind` are the only direct client
      // writes; declare/validate/cancel and Stripe updates go through
      // Cloud Functions with the Admin SDK.
      allow update: if canWriteClubContent(resource.data.clubId)
        && paymentItemClientUpdateIsValid();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isOwnMember(resource.data.clubId, resource.data.memberId);
      // Created only by Cloud Function triggers (Admin SDK).
      allow create: if false;
    }

    match /device_push_tokens/{token} {
      allow create, update: if isOwnProfile(request.resource.data.memberId)
        && pushTokenFieldsAreValid();
      allow delete: if isOwnProfile(resource.data.memberId);
      allow read: if false;
    }

    match /invitations/{invitationId} {
      // Created by `createInvitation`, consumed by `acceptInvitation` — both
      // Cloud Functions using the Admin SDK, which bypasses these rules.
      allow read, write: if false;
    }

    match /mail/{mailId} {
      // Only Cloud Functions using the Admin SDK may write transactional mail.
      allow read, write: if false;
    }
  }
}
